{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Quarto: Render PTIG presentation",
      "type": "shell",
      "command": "quarto render ptig_presentation.qmd",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "XDG_CACHE_HOME": "${workspaceFolder}/.cache",
          "DENO_DIR": "${workspaceFolder}/.cache/deno",
          "QUARTO_CACHE_DIR": "${workspaceFolder}/.cache/quarto"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Quarto: Preview PTIG presentation",
      "type": "shell",
      "command": "quarto preview ptig_presentation.qmd --no-browser",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "XDG_CACHE_HOME": "${workspaceFolder}/.cache",
          "DENO_DIR": "${workspaceFolder}/.cache/deno",
          "QUARTO_CACHE_DIR": "${workspaceFolder}/.cache/quarto"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}